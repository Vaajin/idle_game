<Window x:Class="idle_game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:idle_game"
        mc:Ignorable="d"
        Title="Rosa Lunaris"
        Height="450"
        Width="800">

    <Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="🌙 ROSA LUNARIS"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="A Magical Rose Garden"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <TextBlock x:Name="RosePetalsText"
                       Text="🌹 0.0 Rose Petals"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="PetalsPerSecondText"
                       Text="+1.0 Petals per second"
                       FontSize="20"
                       HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</Window>